{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@production-manager/domain/*": ["packages/domain/src/*"],
      "@production-manager/db/*": ["packages/db/src/*"],
      "@production-manager/ui/*": ["packages/ui/src/*"],
      "@production-manager/integrations/*": ["packages/integrations/src/*"]
    }
  }
}
