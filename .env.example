# App
NEXT_PUBLIC_APP_NAME=Production Manager
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=

# Worker / GCP
GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_WORKER_BASE_URL=
CLOUD_TASKS_LOCATION=australia-southeast1
CLOUD_TASKS_QUEUE_DEFAULT=default

# MYOB
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
MYOB_REDIRECT_URI=
MYOB_API_BASE_URL=

MYOB_BUSINESS_API_BASE_URL=https://api.myob.com/accountright
# Install Scheduler survey bridge
# Production Manager calls this Firebase HTTPS function when a site survey is requested.
INSTALL_SCHEDULER_CREATE_SURVEY_URL=
# Production Manager calls this Firebase HTTPS function when production is ready for install.
INSTALL_SCHEDULER_CREATE_INSTALL_JOB_URL=
# Shared secret sent as Authorization: Bearer <secret>. Must match Firebase PM_BRIDGE_KEY.
INSTALL_SCHEDULER_BRIDGE_KEY=
# Used only for displaying links if the bridge response does not include a URL.
INSTALL_SCHEDULER_BASE_URL=https://install-scheduler.web.app
